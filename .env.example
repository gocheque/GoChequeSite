# =============================================================================
# GoCheques — Configuration Supabase + Stripe
# =============================================================================
# 1) Dashboard Supabase > Settings > API
# 2) Exécuter supabase/migrations/*.sql dans SQL Editor (incl. 006_stripe)
# 3) E-mails d'inscription GoCheque : npm run email:supabase
#    (token : https://supabase.com/dashboard/account/tokens → SUPABASE_ACCESS_TOKEN)
# 4) Dashboard Stripe > Developers > API keys + Webhooks
# 5) npm run env:check && npm run dev
# =============================================================================

# URL publique du site (SEO, sitemap, Open Graph)
# En local : http://localhost:3000
# En prod : https://gocheque.ca
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Clés publiques Supabase (client + middleware)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Clé secrète serveur uniquement — NE JAMAIS exposer côté client
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Optionnel — pour appliquer les modèles d'e-mail GoCheque (npm run email:supabase)
# SUPABASE_ACCESS_TOKEN="sbp_..."

# Stripe — paiement des forfaits (CAD)
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY="sk_test_..."
# Webhook endpoint: https://votre-domaine.com/api/stripe/webhook
# Events: checkout.session.completed
# En local: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# =============================================================================
# Protection temporaire pré-lancement (Vercel Production)
# =============================================================================
# Mot de passe navigateur (Basic Auth). User par défaut : gocheque
# SITE_ACCESS_USER="gocheque"
# SITE_ACCESS_PASSWORD="ton-mot-de-passe-secret"
# Couper les achats même si quelqu'un est connecté :
# PURCHASES_ENABLED="false"
# Au lancement : supprimer SITE_ACCESS_PASSWORD et mettre PURCHASES_ENABLED="true"
